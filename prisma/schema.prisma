// CRM Pipedrive Clone - Full Database Schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ============ ORGANIZATION & USERS ============

model Organization {
  id        String   @id @default(cuid())
  name      String
  slug      String   @unique
  plan      Plan     @default(STARTER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Business details
  website   String?
  phone     String?
  vatNumber String?
  address   String?
  city      String?
  country   String?
  sector    String?

  // Custom billing types defined by the org
  customBillingTypes      Json?
  customProductCategories Json?

  // CRM vertical mode (CLASSIC | PMI | AGENZIE | COMMERCIALE | CONSULENTI | STARTUP | IMMOBILIARE | ASSICURAZIONI | ECOMMERCE)
  crmMode String?

  // Stripe billing
  stripeCustomerId       String?   @unique
  stripeSubscriptionId   String?   @unique
  stripePriceId          String?
  stripeCurrentPeriodEnd DateTime?

  users               User[]
  invitations         Invitation[]
  pipelines           Pipeline[]
  deals               Deal[]
  contacts            Contact[]
  companies           Company[]
  activities          Activity[]
  leads               Lead[]
  products            Product[]
  workflows           Workflow[]
  customFields        CustomField[]
  emailTemplates      EmailTemplate[]
  emailLists          EmailList[]
  emailCampaigns      EmailCampaign[]
  smtpConfig          SmtpConfig?
  leadFinderSearches  LeadFinderSearch[]
  leadCandidates      LeadCandidate[]
  apiKeys             ApiKey[]
}

model Invitation {
  id             String       @id @default(cuid())
  email          String
  role           Role         @default(SALES)
  token          String       @unique
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  acceptedAt     DateTime?
}

enum Plan {
  STARTER      // piano gratuito (nuovo default)
  PRO          // €29/mese
  ENTERPRISE   // custom
  // valori legacy — non usare per nuovi utenti
  FREE
  ESSENTIAL
  ADVANCED
  PROFESSIONAL
}

model User {
  id             String       @id @default(cuid())
  email          String       @unique
  name           String?
  passwordHash   String?
  role           Role         @default(SALES)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  googleCalendarToken        String?
  googleCalendarRefreshToken String?
  googleCalendarTokenExpiry  DateTime?

  ownedDeals     Deal[]         @relation("DealOwner")
  ownedContacts  Contact[]      @relation("ContactOwner")
  ownedLeads     Lead[]         @relation("LeadOwner")
  activities     Activity[]
  emailAccounts  EmailAccount[]
  notifications  Notification[]
  apiKeys        ApiKey[]

  @@index([organizationId])
}

enum Role {
  OWNER
  ADMIN
  MANAGER
  SALES
  VIEWER
}

// ============ PIPELINE & DEALS ============

model Pipeline {
  id             String       @id @default(cuid())
  name           String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  position       Int          @default(0)
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())

  stages Stage[]
  deals  Deal[]
}

model Stage {
  id         String   @id @default(cuid())
  pipelineId String
  pipeline   Pipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  name       String
  position   Int
  probability Int     @default(0) // 0-100
  rotting    Int?     // days before deal becomes "rotting"

  deals Deal[]
}

model Deal {
  id             String       @id @default(cuid())
  title          String
  value          Decimal      @default(0)
  currency       String       @default("EUR")
  status         DealStatus   @default(OPEN)
  expectedClose  DateTime?
  closedAt       DateTime?
  lostReason     String?
  pipelineId     String
  pipeline       Pipeline     @relation(fields: [pipelineId], references: [id])
  stageId        String
  stage          Stage        @relation(fields: [stageId], references: [id])
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation("DealOwner", fields: [ownerId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])

  activities   Activity[]
  notes        Note[]
  emails       Email[]
  products     DealProduct[]
  customValues CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([stageId])
  @@index([ownerId])
}

enum DealStatus {
  OPEN
  WON
  LOST
  DELETED
}

// ============ CONTACTS & COMPANIES ============

model Contact {
  id             String       @id @default(cuid())
  firstName      String
  lastName       String?
  email          String?
  phone          String?
  jobTitle       String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId        String
  owner          User         @relation("ContactOwner", fields: [ownerId], references: [id])
  companyId      String?
  company        Company?     @relation(fields: [companyId], references: [id])

  deals        Deal[]
  leads        Lead[]             @relation("LeadContact")
  activities   Activity[]
  emails       Email[]
  customValues CustomFieldValue[]
  tags         Tag[]              @relation("ContactTags")
  notes        Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([email])
}

model Company {
  id             String       @id @default(cuid())
  name           String
  website        String?
  industry       String?
  size           String?
  address        String?
  city           String?
  country        String?
  email          String?
  phone          String?
  vatNumber      String?
  description    String?
  linkedinUrl    String?
  referentName   String?
  referentRole   String?
  referentEmail  String?
  referentPhone  String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  contacts     Contact[]
  deals        Deal[]
  customValues CustomFieldValue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Tag {
  id             String @id @default(cuid())
  name           String
  color          String @default("#3b82f6")
  organizationId String

  contacts Contact[] @relation("ContactTags")
}

// ============ ACTIVITIES ============

model Activity {
  id             String       @id @default(cuid())
  type           ActivityType
  subject        String
  notes          String?
  dueDate        DateTime?
  completedAt    DateTime?
  duration       Int?         // minutes
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id])
  dealId         String?
  deal           Deal?        @relation(fields: [dealId], references: [id])
  contactId      String?
  contact        Contact?     @relation(fields: [contactId], references: [id])

  createdAt DateTime @default(now())

  @@index([userId, dueDate])
}

enum ActivityType {
  CALL
  MEETING
  EMAIL
  TASK
  DEADLINE
  LUNCH
}

// ============ LEADS ============

model Lead {
  id              String       @id @default(cuid())
  title           String
  source          String?
  score           Int          @default(0)
  status          LeadStatus   @default(NEW)
  data            Json         // form payload
  email           String?
  phone           String?
  notes           String?      @db.Text
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  ownerId         String?
  owner           User?        @relation("LeadOwner", fields: [ownerId], references: [id])
  contactId       String?
  contact         Contact?     @relation("LeadContact", fields: [contactId], references: [id])
  convertedDealId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  DISQUALIFIED
}

// ============ EMAILS ============

model EmailAccount {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider     String   // gmail, outlook, imap
  email        String
  accessToken  String?
  refreshToken String?
  isActive     Boolean  @default(true)
}

model Email {
  id             String    @id @default(cuid())
  subject        String
  body           String    @db.Text
  fromAddress    String
  fromName       String?
  toAddresses    String[]
  ccAddresses    String[]  @default([])
  status         String    @default("SENT") // SENT, DRAFT, RECEIVED
  threadId       String?
  sentAt         DateTime?
  openedAt       DateTime?
  clickedAt      DateTime?
  contactId      String?
  contact        Contact?  @relation(fields: [contactId], references: [id])
  dealId         String?
  deal           Deal?     @relation(fields: [dealId], references: [id])
  trackingId     String    @unique @default(cuid())
  organizationId String?

  createdAt DateTime @default(now())

  @@index([organizationId])
  @@index([threadId])
}

model EmailTemplate {
  id             String   @id @default(cuid())
  name           String
  subject        String
  body           String   @db.Text
  category       String
  usageCount     Int      @default(0)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
}

// ============ PRODUCTS ============

model Product {
  id             String       @id @default(cuid())
  name           String
  code           String?
  description    String?
  category       String       @default("OTHER")
  unit           String       @default("pz")
  unitPrice      Decimal
  currency       String       @default("EUR")
  taxRate        Decimal      @default(22)
  isActive       Boolean      @default(true)
  isSubscription Boolean      @default(false)
  billingPeriod  String?      // "monthly" | "annual" | null
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  dealProducts DealProduct[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DealProduct {
  id        String  @id @default(cuid())
  dealId    String
  deal      Deal    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  productId String
  product   Product @relation(fields: [productId], references: [id])
  quantity  Int     @default(1)
  unitPrice Decimal
  discount  Decimal @default(0)
}

// ============ WORKFLOWS ============

model Workflow {
  id             String       @id @default(cuid())
  name           String
  description    String?
  isActive       Boolean      @default(false)
  trigger        Json
  steps          Json
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  executions   WorkflowExecution[]
  queuedSteps  WorkflowQueue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model WorkflowExecution {
  id         String    @id @default(cuid())
  workflowId String
  workflow   Workflow  @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  status     String
  payload    Json
  logs       Json[]
  startedAt  DateTime  @default(now())
  finishedAt DateTime?
}

// ============ CUSTOM FIELDS ============

model CustomField {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  entityType     String       // "deal", "contact", "company"
  name           String
  fieldType      String       // text, number, date, select, multiselect
  options        Json?        // for select/multiselect
  isRequired     Boolean      @default(false)

  values CustomFieldValue[]
}

model CustomFieldValue {
  id        String      @id @default(cuid())
  fieldId   String
  field     CustomField @relation(fields: [fieldId], references: [id], onDelete: Cascade)
  dealId    String?
  deal      Deal?       @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact?    @relation(fields: [contactId], references: [id], onDelete: Cascade)
  companyId String?
  company   Company?    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  value     String
}

// ============ MISC ============

model Note {
  id        String   @id @default(cuid())
  content   String   @db.Text
  dealId    String?
  deal      Deal?    @relation(fields: [dealId], references: [id], onDelete: Cascade)
  contactId String?
  contact   Contact? @relation(fields: [contactId], references: [id], onDelete: Cascade)
  authorId  String
  createdAt DateTime @default(now())
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  message   String
  link      String?
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

// ============ EMAIL CAMPAIGNS ============

model EmailList {
  id             String   @id @default(cuid())
  name           String
  description    String?
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  contacts       EmailListContact[]
  campaigns      EmailCampaign[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

model EmailListContact {
  id           String    @id @default(cuid())
  listId       String
  list         EmailList @relation(fields: [listId], references: [id], onDelete: Cascade)
  email        String
  firstName    String?
  lastName     String?
  unsubscribed Boolean   @default(false)
  createdAt    DateTime  @default(now())

  @@unique([listId, email])
  @@index([listId])
}

model EmailCampaign {
  id             String         @id @default(cuid())
  name           String
  subject        String
  body           String         @db.Text
  fromName       String?
  listId         String
  list           EmailList      @relation(fields: [listId], references: [id])
  status         CampaignStatus @default(DRAFT)
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalSent      Int            @default(0)
  totalOpened    Int            @default(0)
  totalClicked   Int            @default(0)
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@index([organizationId])
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
  PAUSED
}

// ============ LEAD FINDER ============

model LeadFinderSearch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sector         String?
  location       String?
  companySize    String?
  keywords       String?
  idealCustomer  String?
  maxResults     Int          @default(10)
  status         String       @default("PENDING") // PENDING | RUNNING | DONE | FAILED
  error          String?
  candidates     LeadCandidate[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
}

model LeadCandidate {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  searchId       String
  search         LeadFinderSearch @relation(fields: [searchId], references: [id], onDelete: Cascade)
  companyName    String
  website        String?
  sector         String?
  location       String?
  companySize    String?
  contactName    String?
  contactRole    String?
  email          String?
  phone          String?
  linkedinUrl    String?
  // Campi CCIAA da FatturatoItalia
  piva           String?
  ateco          String?
  nDipendenti    String?
  formaGiuridica String?
  annoFondazione String?
  score          Int              @default(0)
  source         String           @default("AI")
  motivation     String?
  status         String           @default("PENDING") // PENDING | APPROVED | REJECTED
  leadId         String?
  createdAt      DateTime         @default(now())

  @@index([organizationId])
  @@index([searchId])
}

// ============ WORKFLOW QUEUE ============

model WorkflowQueue {
  id         String   @id @default(cuid())
  workflowId String
  workflow   Workflow @relation(fields: [workflowId], references: [id], onDelete: Cascade)
  stepIndex  Int      // index of next step to execute when resumed
  payload    Json     // full WorkflowPayload serialized
  orgId      String
  ownerId    String
  resumeAt   DateTime
  createdAt  DateTime @default(now())

  @@index([resumeAt])
}

// ============ API KEYS ============

model ApiKey {
  id             String       @id @default(cuid())
  name           String
  keyHash        String       @unique     // SHA-256 hash of the raw key
  prefix         String                   // First 12 chars (e.g. "pip_live_abc1") for display
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy      String
  user           User         @relation(fields: [createdBy], references: [id])
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([keyHash])
}

// ============ SMTP CONFIG ============

model SmtpConfig {
  id             String   @id @default(cuid())
  organizationId String   @unique
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       String   // gmail | aruba | libero | custom
  host           String
  port           Int
  secure         Boolean  @default(false) // true = SSL/TLS, false = STARTTLS
  fromEmail      String
  fromName       String?
  username       String
  passwordEnc    String   // AES-256 encrypted
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
