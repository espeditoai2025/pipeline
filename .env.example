# ============================================================
# CRM Pipedrive Clone - Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# Database (PostgreSQL - Neon / Supabase / local)
DATABASE_URL=postgresql://user:password@localhost:5432/crm_db

# NextAuth.js / Auth.js
NEXTAUTH_SECRET=your_random_secret_here_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft OAuth (https://portal.azure.com/)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email - Resend (https://resend.com/)
RESEND_API_KEY=

# Payments - Stripe (https://stripe.com/)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI - Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Background Jobs - Inngest (https://inngest.com/)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# File Upload - Uploadthing (https://uploadthing.com/)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Cache - Upstash Redis (https://upstash.com/)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring - Sentry (https://sentry.io/)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics - PostHog (https://posthog.com/)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App URL (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000
