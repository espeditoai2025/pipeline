# ============================================================
# Pipely - Environment Variables
# Copy this file to .env.local and fill in the values
# ============================================================

# ── Database (Supabase) ──────────────────────────────────────────────────────
# Transaction pooler → runtime app (porta 6543, con ?pgbouncer=true)
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection → solo prisma migrate (porta 5432)
DIRECT_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-eu-central-1.pooler.supabase.com:5432/postgres

# NextAuth.js / Auth.js
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=your_random_secret_here_min_32_chars
NEXTAUTH_URL=http://localhost:3000

# Google OAuth (https://console.cloud.google.com/)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Google Maps / Places API (https://console.cloud.google.com/ → Places API New)
GOOGLE_MAPS_API_KEY=

# Microsoft OAuth (https://portal.azure.com/)
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Email - Resend (https://resend.com/)
RESEND_API_KEY=

# Payments - Stripe (https://stripe.com/)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI - Anthropic Claude (https://console.anthropic.com/)
ANTHROPIC_API_KEY=

# Background Jobs - Inngest (https://inngest.com/)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# File Upload - Uploadthing (https://uploadthing.com/)
UPLOADTHING_SECRET=
UPLOADTHING_APP_ID=

# Cache - Upstash Redis (https://upstash.com/)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Monitoring - Sentry (https://sentry.io/)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# Analytics - PostHog (https://posthog.com/)
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://app.posthog.com

# App URL (production)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Secret di sicurezza (fail-closed: senza questi i relativi endpoint sono disabilitati) ──
# Cron job /api/cron/backup — senza CRON_SECRET l'endpoint risponde 503
CRON_SECRET=
# Scraper Python /api/scraper — senza SCRAPER_SECRET_KEY l'endpoint risponde 503
SCRAPER_SECRET_KEY=
# URL del servizio scraper Python (se separato); se assente usa lo scraper TS interno
SCRAPER_SERVICE_URL=
# Cifratura credenziali SMTP a riposo — genera con: openssl rand -base64 32
SMTP_ENCRYPTION_KEY=
